generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Patient {
  id                           String   @id @default(cuid())
  mrn                          String   @unique
  firstName                    String
  lastName                     String
  preferredName                String?
  sex                          String
  dateOfBirth                  String
  age                          Int
  pediatric                    Boolean  @default(false)
  status                       String   @default("Active")
  preferredLanguage            String?
  pronouns                     String?
  addressStreet                String?
  addressCity                  String?
  addressState                 String?
  addressZip                   String?
  phone                        String?
  email                        String?
  maritalStatus                String?
  employer                     String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  primaryDepartment            String
  pcpName                      String?
  pcpProviderId                String?
  primaryProviderName          String?
  primaryProviderId            String?
  lastSeenDate                 String?
  registrationDate             String?
  modifiedByType               String?
  modifiedByAgentName          String?
  modifiedAt                   String?
  createdAt                    DateTime @default(now())

  insurances            PatientInsurance[]
  allergies             PatientAllergy[]
  problems              PatientProblem[]
  medications           PatientMedication[]
  encounters            PatientEncounter[]
  imagingStudies        PatientImagingStudy[]
  seizureEvents         PatientSeizureEvent[]
  careTeamMembers       PatientCareTeamMember[]
  appointments          PatientAppointment[]
  reconciliationPrompts PatientReconciliationPrompt[]
  labResults            PatientLabResult[]
  cardiacStudies        PatientCardiacStudy[]
  devices               PatientDevice[]
  riskScores            PatientRiskScore[]
  vitalSigns            PatientVitalSign[]
  agentObservations     PatientAgentObservation[]
  labOrders             LabOrder[]

  @@index([lastName, firstName])
  @@index([dateOfBirth])
}

model PatientInsurance {
  id                  String  @id @default(cuid())
  patientId           String
  patient             Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  slot                String
  payerName           String
  payerShort          String?
  memberId            String?
  groupNumber         String?
  eligibilityStatus   String  @default("Active")
  lastVerifiedAt      String?
  verifiedByType      String?
  verifiedByAgentName String?
  effectiveStart      String?
  effectiveEnd        String?

  @@index([patientId])
}

model PatientAllergy {
  id                  String  @id @default(cuid())
  patientId           String
  patient             Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  substance           String
  reaction            String?
  severity            String?
  yearIdentified      Int?
  active              Boolean @default(true)
  modifiedByType      String?
  modifiedByAgentName String?

  @@index([patientId])
}

model PatientProblem {
  id                  String  @id @default(cuid())
  patientId           String
  patient             Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name                String
  icd10               String?
  status              String
  department          String?
  onsetYear           Int?
  modifiedByType      String?
  modifiedByAgentName String?

  @@index([patientId])
  @@index([patientId, department])
}

model PatientMedication {
  id                  String  @id @default(cuid())
  patientId           String
  patient             Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name                String
  dose                String?
  frequency           String?
  indication          String?
  prescribingProvider String?
  startedYear         Int?
  active              Boolean @default(true)
  modifiedByType      String?
  modifiedByAgentName String?

  @@index([patientId])
}

model PatientEncounter {
  id                  String  @id @default(cuid())
  patientId           String
  patient             Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterDate       String?
  visitType           String?
  department          String?
  providerName        String?
  summary             String?
  status              String  @default("complete")
  modifiedByType      String?
  modifiedByAgentName String?

  @@index([patientId])
  @@index([patientId, department])
}

model PatientImagingStudy {
  id                  String  @id @default(cuid())
  patientId           String
  patient             Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  studyName           String?
  studyDate           String?
  finding             String?
  department          String?
  status              String  @default("complete")
  modifiedByType      String?
  modifiedByAgentName String?

  @@index([patientId])
}

model PatientSeizureEvent {
  id              String  @id @default(cuid())
  patientId       String
  patient         Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  eventDate       String?
  durationSeconds Int?
  type            String?
  notes           String?

  @@index([patientId])
}

model PatientCareTeamMember {
  id           String  @id @default(cuid())
  patientId    String
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String
  role         String?
  relationship String?

  @@index([patientId])
}

model PatientAppointment {
  id              String  @id @default(cuid())
  patientId       String
  patient         Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentDate String?
  appointmentTime String?
  visitType       String?
  providerName    String?
  noShowRisk      String?
  status          String  @default("Scheduled")

  @@index([patientId])
}

model PatientReconciliationPrompt {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type      String?
  agentName String?
  createdAt String?
  message   String?
  resolved  Boolean @default(false)

  @@index([patientId])
}

model AgentActionRecord {
  id               String     @id
  agentName        String
  confidence       String
  summary          String
  detail           String
  reasoningSummary String
  sources          String     // JSON-encoded AgentActionSource[]
  patientName      String
  patientMrn       String
  actionTimestamp  DateTime
  category         String
  status           String     @default("pending")
  createdAt        DateTime   @default(now())
  decisions        Decision[]
}

model Decision {
  id        String            @id @default(cuid())
  actionId  String
  action    AgentActionRecord @relation(fields: [actionId], references: [id])
  operation String            // 'approve' | 'reject' | 'snooze'
  reason    String?
  decidedBy String
  decidedAt DateTime          @default(now())
}

model PatientLabResult {
  id                  String  @id @default(cuid())
  patientId           String
  patient             Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  testName            String
  value               String
  unit                String?
  refRange            String?
  flag                String?
  resultedAt          String?
  modifiedByType      String?
  modifiedByAgentName String?

  @@index([patientId])
}

model PatientCardiacStudy {
  id                  String  @id @default(cuid())
  patientId           String
  patient             Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  studyType           String
  performedAt         String?
  summary             String?
  lvef                Int?
  modifiedByType      String?
  modifiedByAgentName String?

  @@index([patientId])
}

model PatientDevice {
  id                  String  @id @default(cuid())
  patientId           String
  patient             Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  deviceType          String
  implantedAt         String?
  lastInterrogationAt String?
  batteryStatus       String?
  afBurdenPct         Float?
  therapiesDelivered  Int?
  physician           String?
  modifiedByType      String?
  modifiedByAgentName String?

  @@index([patientId])
}

model PatientRiskScore {
  id           String  @id @default(cuid())
  patientId    String
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String
  displayName  String?
  value        Int
  severity     String
  computedAt   String?
  inputs       String?
  agentName    String?
  modelVersion String?

  @@index([patientId])
}

model PatientVitalSign {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  takenAt   String?
  systolic  Int?
  diastolic Int?
  hr        Int?
  source    String?

  @@index([patientId])
}

model PatientAgentObservation {
  id           String  @id @default(cuid())
  patientId    String
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category     String
  title        String
  detail       String?
  agentName    String?
  confidence   String?
  computedAt   String?
  whyRationale String?
  whyInputs    String?
  dismissed    Boolean @default(false)

  @@index([patientId])
}

model LabCatalogItem {
  code            String  @id
  name            String
  aliases         String?
  category        String
  specimen        String?
  cpt             String?
  setting         String  @default("both")
  fastingRequired Boolean @default(false)
  sendOut         Boolean @default(false)
  defaultPriority String  @default("routine")
  isPanel         Boolean @default(false)
  panelComponents String?
  orders          LabOrder[]

  @@index([category])
  @@index([name])
}

model LabOrderSet {
  id          String @id @default(cuid())
  name        String
  setting     String @default("both")
  memberCodes String
}

model PerformingLocation {
  id           String     @id @default(cuid())
  type         String
  name         String
  address      String?
  active       Boolean    @default(true)
  capabilities String?
  questPscs    QuestPsc[]
  orders       LabOrder[]
}

model QuestPsc {
  id                   String             @id @default(cuid())
  name                 String
  address              String
  zip                  String
  hours                String?
  lat                  Float?
  lng                  Float?
  performingLocationId String
  performingLocation   PerformingLocation @relation(fields: [performingLocationId], references: [id])

  @@index([zip])
}

// ---- Insurance Document Agent (§2.6) ----

// One logical document: a single file, a multi-page PDF, or a front+back card pair.
model InsuranceDocument {
  id               String   @id @default(cuid())
  patientMrn       String
  documentType     String   @default("unknown") // insurance_card | eligibility_letter | eob | unknown
  status           String   @default("uploaded") // uploaded | scanning | pending_review | approved | rejected
  rejectReason     String?
  pages            Int      @default(1)
  // Storage refs — paths are slugs only, never original filenames (no PHI in paths).
  bucket           String
  frontStoragePath String
  frontMimeType    String
  backStoragePath  String?
  backMimeType     String?
  fileSize         Int
  uploadedBy       String   @default("demo-user")
  uploadedAt       DateTime @default(now())

  extractions InsuranceExtraction[]

  @@index([patientMrn, uploadedAt])
}

// Immutable once created — the Explainability Drawer's frozen-rationale rule.
model InsuranceExtraction {
  id           String            @id @default(cuid())
  documentId   String
  document     InsuranceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  payload      String // JSON-encoded InsuranceExtraction contract (lib/types/insurance.ts)
  agentName    String            @default("Insurance Agent")
  modelVersion String
  extractedAt  DateTime          @default(now())

  @@index([documentId])
}

// Committed, versioned coverage record. Approving an extraction inserts a new
// version and links the previous one — never destructive.
model InsuranceCoverage {
  id                       String   @id @default(cuid())
  patientMrn               String
  priority                 String   @default("primary") // primary | secondary
  payerName                String
  planName                 String?
  planType                 String?
  memberId                 String?
  groupNumber              String?
  subscriberName           String?
  subscriberDob            String?
  relationshipToSubscriber String?
  effectiveDate            String?
  rxBin                    String?
  rxPcn                    String?
  rxGroup                  String?
  copays                   String? // JSON { pcp?, specialist?, er?, rx? }
  payerPhone               String?
  claimsAddress            String?
  verifiedAt               String?
  sourceDocumentId         String?
  version                  Int      @default(1)
  supersededById           String? // points at the newer version that replaced this row
  modifiedByType           String   @default("agent")
  modifiedByAgentName      String?
  createdAt                DateTime @default(now())

  @@index([patientMrn, version])
}

model LabOrder {
  id                   String              @id @default(cuid())
  patientId            String
  patient              Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  catalogCode          String
  catalogItem          LabCatalogItem      @relation(fields: [catalogCode], references: [code])
  setting              String              @default("out")
  priority             String              @default("routine")
  frequency            String              @default("once")
  futureDate           String?
  indicationIcd        String?
  indicationText       String?
  performingLocationId String?
  performingLocation   PerformingLocation? @relation(fields: [performingLocationId], references: [id])
  pscId                String?
  status               String              @default("pended")
  pendedBy             String?
  pendedByType         String?
  pendedByAgentName    String?
  pendedByRationale    String?
  releasedBy           String?
  orderedAt            String
  releasedAt           String?
  cancelledAt          String?
  modifiedByType       String?
  modifiedByAgentName  String?
  notes                String?

  @@index([patientId])
  @@index([patientId, status])
  @@index([catalogCode])
}
